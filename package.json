{
  "name": "surrealdb-datasource",
  "version": "0.3.0",
  "description": "SurrealDB datasource plugin for Grafana",
  "scripts": {
    "build": "webpack -c ./.config/webpack/webpack.config.ts --env production",
    "dev": "webpack -w -c ./.config/webpack/webpack.config.ts --env development",
    "e2e:report": "yarn playwright show-report",
    "e2e:ui": "yarn playwright test --ui",
    "e2e": "playwright test",
    "lint:fix": "yarn run lint --fix && prettier --write --list-different .",
    "lint": "eslint --cache .",
    "server": "docker compose up --build",
    "sign": "sign-plugin",
    "test:ci": "jest --passWithNoTests --maxWorkers 4",
    "test": "jest --watch --onlyChanged",
    "typecheck": "tsc --noEmit"
  },
  "author": "Grafana Labs",
  "license": "Apache-2.0",
  "devDependencies": {
    "@babel/core": "^7.28.0",
    "@grafana/eslint-config": "^9.0.0",
    "@grafana/plugin-e2e": "^3.9.1",
    "@grafana/sign-plugin": "^3.3.1",
    "@grafana/tsconfig": "^2.2.0",
    "@playwright/test": "^1.54.1",
    "@stylistic/eslint-plugin-ts": "^3.1.0",
    "@swc/core": "^1.13.2",
    "@swc/helpers": "^0.5.17",
    "@swc/jest": "^0.2.38",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "6.6.3",
    "@testing-library/react": "^16.3.0",
    "@types/jest": "^29.5.14",
    "@types/lodash": "^4.17.20",
    "@types/node": "^22.15.3",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/react-router-dom": "^5.3.3",
    "@typescript-eslint/eslint-plugin": "^8.31.1",
    "@typescript-eslint/parser": ">=8.31.1",
    "copy-webpack-plugin": "^13.0.0",
    "css-loader": "^7.1.2",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^10.1.2",
    "eslint-plugin-jsdoc": "^51.4.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-webpack-plugin": "^5.0.1",
    "fork-ts-checker-webpack-plugin": "^9.1.0",
    "glob": "^11.0.2",
    "identity-obj-proxy": "3.0.0",
    "imports-loader": "^5.0.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "prettier": "^3.5.3",
    "replace-in-file-webpack-plugin": "^1.0.6",
    "sass": "1.87.0",
    "sass-loader": "16.0.5",
    "semver": "^7.7.1",
    "style-loader": "4.0.0",
    "swc-loader": "^0.2.6",
    "terser-webpack-plugin": "^5.3.14",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.8.3",
    "webpack": "^5.99.7",
    "webpack-cli": "^6.0.1",
    "webpack-livereload-plugin": "^3.0.2",
    "webpack-subresource-integrity": "^5.1.0",
    "webpack-virtual-modules": "^0.6.2"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@emotion/css": "^11.13.5",
    "@grafana/data": "^13.1.0",
    "@grafana/i18n": "^13.1.0",
    "@grafana/plugin-ui": "^0.16.0",
    "@grafana/runtime": "^13.1.0",
    "@grafana/schema": "^13.1.0",
    "@grafana/ui": "^13.1.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tslib": "2.8.1"
  },
  "resolutions": {
    "jackspeak": "2.1.1"
  },
  "packageManager": "yarn@1.22.22",
  "volta": {
    "node": "20.18.0",
    "yarn": "1.22.22"
  }
}
